# Google Sheets - Choose ONE method:

# Method A: Google Apps Script (Recommended - easiest)
# 1. Copy code from GOOGLE_APPS_SCRIPT.js in this project
# 2. Open Sheet -> Extensions -> Apps Script -> Paste & Deploy as Web App
# 3. Access must be set to "Anyone"
VITE_APPS_SCRIPT_URL=

# Method B: Service Account (Advanced)
# 1. Create Service Account in Google Cloud
# 2. Share your Sheet with the Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
